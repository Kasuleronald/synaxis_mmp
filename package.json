{
  "name": "life-mmp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/api && npm run build --workspace apps/web",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run prisma:migrate --workspace apps/api",
    "db:seed": "npm run seed --workspace apps/api"
  }
}

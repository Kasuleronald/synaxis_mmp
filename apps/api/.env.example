# Copy to .env and fill in. Never commit the real .env.

# Superuser bootstrap connection -- used only by `prisma migrate` / `prisma generate`.
DATABASE_URL="postgresql://life_mmp:life_mmp_dev@localhost:5432/life_mmp?schema=public"

# Restricted role the running API actually connects as (see db/init/01-app-role.sql).
# Not a superuser, so Postgres row-level security is actually enforced -- see
# the RLS policies at the bottom of prisma/migrations/20260819000000_init/migration.sql.
RUNTIME_DATABASE_URL="postgresql://life_mmp_app:life_mmp_app_dev@localhost:5432/life_mmp?schema=public"

SESSION_SECRET="change-me-to-a-long-random-string"
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Paste your Gemini API key here directly -- never in chat, never committed.
# Used only by the Import Center (Sprint 3) for unstructured document extraction
# (PDFs, and spreadsheets whose headers didn't map deterministically).
GEMINI_API_KEY=""
# Optional override -- defaults to gemini-2.0-flash.
GEMINI_MODEL=""

# Bootstrap Platform Administrator -- used once by `npm run seed`.
PLATFORM_ADMIN_EMAIL="admin@lifemmp.local"
PLATFORM_ADMIN_PASSWORD="change-me-before-seeding"
PLATFORM_ADMIN_NAME="Platform Administrator"
